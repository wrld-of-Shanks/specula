# Specula Environment Variables
# Copy this file to `.env` and fill in the REQUIRED values before running
# `docker-compose up`. The stack will refuse to start if they are missing.

# MongoDB (REQUIRED for docker-compose)
# Pick a strong username and password. Used to create the Mongo root user and
# authenticate all services. Never commit the real value to git.
# NOTE: the password is embedded in a connection string, so avoid the special
# characters @ : / ? # [ ] in both username and password.
MONGO_USERNAME=
MONGO_PASSWORD=

# Gateway
GATEWAY_PORT=3000
# REQUIRED: set a strong, random value. The gateway will refuse to start if unset.
# Generate one with: openssl rand -hex 32
API_KEY=
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=info

# Network Service
NETWORK_SERVICE=http://localhost:5001
NETWORK_PORT=5001

# Code Service
CODE_SERVICE=http://localhost:5002
CODE_PORT=5002

# DAST Service
DAST_SERVICE=http://localhost:5003
DAST_PORT=5003

# Dashboard
REACT_APP_API_BASE=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000/ws

# Model Training (optional)
# MODEL_DIR=./models/weights
# DATA_DIR=./data

# Auto-Fix & Pull Request (optional)
# Personal access token with `repo` scope. Also used to authenticate repository
# cloning in the repo-scan feature. Never commit the real value.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Set to false to disable the one-click auto-fix / PR feature entirely.
AUTO_FIX_ENABLED=true
# Maximum auto-fix PRs/issues per IP per rolling 24h.
MAX_AUTO_FIX_DAILY=50

# Report Generation (optional)
# Local directory where generated PDF reports are stored. Reports expire after
# REPORT_TTL_DAYS and are cleaned up automatically.
REPORT_STORAGE_PATH=./reports
REPORT_TTL_DAYS=7
# Optional public base URL used to build absolute download links (e.g. https://specula.example.com)
# PUBLIC_REPORT_BASE_URL=

# Slack Notification (optional)
# Incoming webhook URL. Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#security-alerts

# Email Notification (optional)
# SMTP server used to send notification emails. For Gmail use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=security@specula.io
# Comma-separated default recipients when none are supplied per request.
NOTIFICATION_EMAIL_RECIPIENTS=
