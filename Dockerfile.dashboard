FROM node:20-alpine AS landing-build

WORKDIR /app

COPY frontend/landing/package*.json /app/
RUN npm install

COPY frontend/landing/ /app/
RUN npm run build

FROM node:20-alpine AS dashboard-build

WORKDIR /app

COPY frontend/dashboard/package*.json /app/
RUN npm install

COPY frontend/dashboard/ /app/
RUN npm run build

FROM nginx:alpine

# Required at runtime: injects the gateway API key server-side (never in the
# browser bundle). nginx:alpine ships envsubst.
RUN apk add --no-cache gettext

COPY --from=landing-build /app/dist /usr/share/nginx/landing
COPY --from=dashboard-build /app/build /usr/share/nginx/dashboard
COPY frontend/dashboard/nginx.conf.template /etc/nginx/conf.d/default.conf.template

# envsubst must not touch nginx's own $host/$uri variables, so only export the
# SPECULA_API_KEY substitution.
COPY frontend/dashboard/docker-entrypoint.sh /docker-entrypoint.d/40-specula.sh
RUN chmod +x /docker-entrypoint.d/40-specula.sh

EXPOSE 3001

CMD ["nginx", "-g", "daemon off;"]
